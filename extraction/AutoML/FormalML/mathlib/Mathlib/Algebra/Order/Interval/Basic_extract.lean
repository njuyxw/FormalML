theorem extracted_formal_statement_0 {α : Type u_2} [inst : OrderedAddCommGroup α] (s t : Interval α) :
  (s - t).length ≤ s.length + t.length := sorry


theorem extracted_formal_statement_1 {α : Type u_2} [inst : OrderedAddCommGroup α] (s t : NonemptyInterval α) :
  (s - t).length = s.length + t.length := sorry


theorem extracted_formal_statement_2 {α : Type u_2} [inst : OrderedCommGroup α] (a a_1 : NonemptyInterval α) :
  a * a_1 = 1 ↔ ∃ a_2 b, a = NonemptyInterval.pure a_2 ∧ a_1 = NonemptyInterval.pure b ∧ a_2 * b = 1 := sorry


theorem extracted_formal_statement_3 {α : Type u_2} [inst : OrderedCommGroup α] (a a_1 : NonemptyInterval α) :
  a * a_1 = 1 ↔ ∃ a_2 b, a = NonemptyInterval.pure a_2 ∧ a_1 = NonemptyInterval.pure b ∧ a_2 * b = 1 := sorry