import Mathlib
import Mathlib.Algebra.Group.Subgroup.Defs

import Mathlib.Algebra.Group.Submonoid.MulOpposite

open Subgroup

theorem extracted_formal_statement_0 {G : Type u_2} [inst : Group G] (H : Subgroup Gᵐᵒᵖ) :
  H.normalizer.unop = H.unop.normalizer := sorry


theorem extracted_formal_statement_1 {G : Type u_2} [inst : Group G] (H : Subgroup Gᵐᵒᵖ) :
  H.normalizer.unop = H.unop.normalizer := sorry


theorem extracted_formal_statement_2 {G : Type u_2} [inst : Group G] (H : Subgroup G) (x : Gᵐᵒᵖ) :
  x ∈ H.normalizer.op ↔ x ∈ H.op.normalizer := sorry


theorem extracted_formal_statement_3 {G : Type u_2} [inst : Group G] (H : Subgroup G) (x : Gᵐᵒᵖ) :
  x ∈ H.normalizer.op ↔ x ∈ H.op.normalizer := sorry