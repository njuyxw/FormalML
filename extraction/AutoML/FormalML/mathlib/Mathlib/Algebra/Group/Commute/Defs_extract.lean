import Mathlib
import Mathlib.Algebra.Group.Semiconj.Defs

open Commute

theorem extracted_formal_statement_0 {G : Type u_1} [inst : Group G] {a b : G} (h : Commute a b) :
  a * (b * a⁻¹) = b := sorry


theorem extracted_formal_statement_1 {G : Type u_1} [inst : Group G] {a b : G} (h : Commute a b) :
  a * (b * a⁻¹) = b := sorry


theorem extracted_formal_statement_2 {G : Type u_1} [inst : Group G] {a b : G} (h : Commute a b) :
  a * b * a⁻¹ = b := sorry


theorem extracted_formal_statement_3 {G : Type u_1} [inst : Group G] {a b : G} (h : Commute a b) :
  a * b * a⁻¹ = b := sorry


theorem extracted_formal_statement_4 {G : Type u_1} [inst : DivisionMonoid G] {a b : G} (hab : Commute a b) :
  (a * b)⁻¹ = a⁻¹ * b⁻¹ := sorry


theorem extracted_formal_statement_5 {G : Type u_1} [inst : DivisionMonoid G] {a b : G} (hab : Commute a b) :
  (a * b)⁻¹ = a⁻¹ * b⁻¹ := sorry


theorem extracted_formal_statement_6 {G : Type u_1} [inst : DivisionMonoid G] {a b : G} (hab : Commute a b) :
  (a * b)⁻¹ = a⁻¹ * b⁻¹ := sorry


theorem extracted_formal_statement_7 {G : Type u_1} [inst : DivisionMonoid G] {a b : G} (hab : Commute a b) :
  (a * b)⁻¹ = a⁻¹ * b⁻¹ := sorry


theorem extracted_formal_statement_8 {S : Type u_3} [inst : Semigroup S] {b c : S} (hbc : Commute b c) (a d : S) :
  a * b * (c * d) = a * c * (b * d) := sorry


theorem extracted_formal_statement_9 {S : Type u_3} [inst : Semigroup S] {b c : S} (hbc : Commute b c) (a d : S) :
  a * b * (c * d) = a * c * (b * d) := sorry


theorem extracted_formal_statement_10 {S : Type u_3} [inst : Semigroup S] {a b : S} (h : Commute a b) (c : S) :
  a * (b * c) = b * (a * c) := sorry


theorem extracted_formal_statement_11 {S : Type u_3} [inst : Semigroup S] {a b : S} (h : Commute a b) (c : S) :
  a * (b * c) = b * (a * c) := sorry


theorem extracted_formal_statement_12 {S : Type u_3} [inst : Semigroup S] {b c : S} (h : Commute b c) (a : S) :
  a * b * c = a * c * b := sorry


theorem extracted_formal_statement_13 {S : Type u_3} [inst : Semigroup S] {b c : S} (h : Commute b c) (a : S) :
  a * b * c = a * c * b := sorry