theorem extracted_formal_statement_0 {J : Type u₁} [inst : Category.{v₁, u₁} J] {C : Type u₃}
  [inst_1 : Category.{v₃, u₃} C] {F : J ⥤ C} (c : Cocone F) {j j' : J} (f : j ⟶ j')
