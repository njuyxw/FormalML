import Mathlib
import Mathlib.GroupTheory.Coset.Basic

import Mathlib.SetTheory.Cardinal.Finite

open scoped Pointwise

open Subgroup

theorem extracted_formal_statement_0 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card (α ⧸ s) ∣ Nat.card α := sorry


theorem extracted_formal_statement_1 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card (α ⧸ s) ∣ Nat.card α := sorry


theorem extracted_formal_statement_2 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card ↥s ∣ Nat.card α := sorry


theorem extracted_formal_statement_3 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card ↥s ∣ Nat.card α := sorry


theorem extracted_formal_statement_4 {α : Type u_1} [inst : Group α] (s : Subgroup α)
  (h : Nat.card α = Nat.card ((α ⧸ s) × ↥s)) : Nat.card α = Nat.card (α ⧸ s) * Nat.card ↥s := sorry


theorem extracted_formal_statement_5 {α : Type u_1} [inst : Group α] (s : Subgroup α)
  (h : Nat.card α = Nat.card ((α ⧸ s) × ↥s)) : Nat.card α = Nat.card (α ⧸ s) * Nat.card ↥s := sorry


theorem extracted_formal_statement_6 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card α = Nat.card ((α ⧸ s) × ↥s) := sorry


theorem extracted_formal_statement_7 {α : Type u_1} [inst : Group α] (s : Subgroup α) :
  Nat.card α = Nat.card ((α ⧸ s) × ↥s) := sorry