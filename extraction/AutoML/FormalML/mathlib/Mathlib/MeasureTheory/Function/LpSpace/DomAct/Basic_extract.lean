theorem extracted_formal_statement_0 {M : Type u_1} {α : Type u_3} {E : Type u_4}
  [inst : MeasurableSpace M] [inst_1 : MeasurableSpace α] [inst_2 : NormedAddCommGroup E] {μ : Measure α} {p : ℝ≥0∞}
  [inst_3 : SMul M α] [inst_4 : SMulInvariantMeasure M α μ] [inst_5 : MeasurableSMul M α] (c : Mᵈᵐᵃ)
  (f g : ↥(Lp E p μ)) : edist (c • f) (c • g) = edist f g := sorry


